# ---------------------------------------------------------------------------
# Parental Gateway - environment configuration
# Copy to `.env` and adjust. docker-compose reads this automatically.
# ---------------------------------------------------------------------------

# Web UI
TZ=Europe/London
WEB_PORT=8080

# Administrator account.
#
# Leave ADMIN_PASSWORD blank to launch the first-run setup wizard in the
# browser (recommended) - the gateway starts with no account at all and the
# wizard creates one. Set it here to auto-provision the account for unattended
# installs. Either way, choose a strong password before exposing the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Force the setup wizard even when ADMIN_PASSWORD is set (e.g. to rotate the
# account on a rebuilt container with an empty database).
REQUIRE_SETUP_WIZARD=0

# Minimum password length accepted by the setup wizard
MIN_PASSWORD_LENGTH=8

# Secret used to sign cookies / session data. Leave blank to auto-generate
# and persist one inside ./data/secret.key (survives container restarts).
SECRET_KEY=

# How long a login session stays valid (hours)
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Gateway / networking
# ---------------------------------------------------------------------------
# 1 = container performs NAT + IP forwarding for the LAN (gateway mode)
# 0 = UI + firewall rules only (useful for testing in bridge networking)
GATEWAY_MODE=1

# Interface facing your LAN clients
LAN_IFACE=eth0

# Interface facing the internet (may be the same as LAN_IFACE)
WAN_IFACE=eth0

# Client subnet in CIDR form. Leave blank to auto-detect from LAN_IFACE.
# LAN_SUBNET=192.168.1.0/24

# Optional: give the LAN interface a static address (gateway mode on a
# dedicated NIC / macvlan). Example: 192.168.1.1/24
# LAN_IP_CIDR=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Background subnet scan interval in minutes (0 = disabled)
SCAN_INTERVAL_MINUTES=10

# How often the firewall ruleset is recomputed and re-applied (seconds)
RECONCILE_INTERVAL_SECONDS=20

# A device is shown as "online" when seen within this many minutes
ONLINE_WINDOW_MINUTES=5

# auto = use iptables when available, otherwise run in dry-run mode
# force = fail loudly when iptables is unavailable
# off   = never touch iptables (dry-run, rules shown in the UI only)
FIREWALL_MODE=auto

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
